# =========================================================================
# Spotify PC Companion Environment Configuration
# Copy this file to .env and adjust values as needed.
# =========================================================================

# ESP32 IP address (Auto-discovery will locate it automatically if omitted)
ESP32_IP=192.168.10.37

# Optional Spotify API credentials (if using direct Spotify Search catalog)
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
